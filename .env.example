# CareFlow configuration template. Copy to ".env" (never commit .env) and edit locally.
# Placeholders below are deliberately invalid so the app refuses to start until you replace them.

CAREFLOW_ENV=development                 # development | production
SECRET_KEY=                              # REQUIRED in production: python -c "import secrets; print(secrets.token_urlsafe(48))"

# ---- Database -------------------------------------------------------------
# PostgreSQL (Supabase): paste the EXACT URI from Supabase Dashboard > Connect (Session pooler). Never invent a host.
# URL-encode special characters in the password (@ -> %40, # -> %23). Remove the [ ] brackets.
# If DATABASE_URL is set but invalid, the app STOPS. It never silently falls back to SQLite.
DATABASE_URL=
# DB_BACKEND=postgres                    # force PostgreSQL: an empty DATABASE_URL then becomes an error, not SQLite
# SQLITE_PATH=hospital.db                # local development only; used only when DATABASE_URL is empty
# DB_CONNECT_TIMEOUT=8
# DB_POOL_SIZE=5

# ---- Demonstration mode (demonstration data, never for real patients) ----------
DEMO_MODE=false
# DEMO_PASSWORD=                         # shared password for demo accounts created by `flask seed-demo`

# PUBLIC_BASE_URL=https://your-site.vercel.app   # address printed in report QR codes (optional: detected from the request)

# ---- Sessions / security ---------------------------------------------------
# SESSION_COOKIE_SECURE=true             # keep true behind HTTPS
# SESSION_IDLE_MINUTES=30
# SESSION_ABSOLUTE_HOURS=12
# LOGIN_MAX_FAILURES=5
# LOGIN_LOCK_MINUTES=15

# ---- Documents ------------------------------------------------------------
# STORAGE_BACKEND=local                  # local | supabase (private bucket, signed URLs)
# UPLOAD_DIR=instance/uploads
# MAX_UPLOAD_MB=20
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=             # SERVER-SIDE ONLY. Never expose to the browser.
# SUPABASE_BUCKET=careflow-documents
# OCR_ENABLED=true
# TESSERACT_CMD=                         # e.g. C:\Program Files\Tesseract-OCR\tesseract.exe

# ---- AI assistant (server-side key; the browser never sees it) -------------
# AI_PROVIDER=anthropic                  # anthropic | openai | local (OpenAI-compatible endpoint)
# AI_MODEL=
# AI_API_KEY=
# AI_BASE_URL=                           # local/OpenAI-compatible servers only
# AI_ALLOW_EXTERNAL_PHI=false            # must be true before ANY patient data is sent to an external provider
# AI_RETENTION_DAYS=90

# ---- Monitoring ------------------------------------------------------------
# SIMULATOR_ENABLED=false                # simulated vitals; always labelled "simulated". Defaults to DEMO_MODE.
# OBS_EXPECTED_INTERVAL_MIN=240
